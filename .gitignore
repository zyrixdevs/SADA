# Rust build outputs; keep Cargo.lock when a binary/workspace is introduced.
/target/

# Python bytecode, virtual environments, and test/type-check outputs.
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version.local
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.junit.xml
test-results/
.tox/

# Local environment files and private credentials. Keep example templates.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.*

# Node tool output and local caches.
node_modules/
.npm/

# IDE, operating-system, and local tool state.
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Pre-commit and local test caches.
.cache/
